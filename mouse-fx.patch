+import { useEffect, type RefObject } from 'react';
+
+import { usePrefersReducedMotion } from './usePrefersReducedMotion';
+
+interface PointerFXOptions {
+  /** Max tilt in degrees at the card edges (default 5). */
+  maxTiltDeg?: number;
+  /** Fraction of the cursor's offset from centre a magnetic element follows. */
+  magnetStrength?: number;
+  /** Clamp (px) on the magnetic translation. */
+  magnetMax?: number;
+}
+
+type FXKind = 'tilt' | 'magnetic';
+
+/**
+ * Desktop pointer effects for the landing, via delegation from one root:
+ *
+ * - `[data-tilt]`     — perspective tilt that follows the cursor. Writes
+ *                       `transform: perspective() rotateX() rotateY()` plus
+ *                       `--glare-x`/`--glare-y` straight to the element; the
+ *                       element's own Tailwind `transition-*` damps the
+ *                       motion. Tailwind v4 translates live in the separate
+ *                       `translate` property, so hover lifts still compose.
+ * - `[data-magnetic]` — the element is pulled a few px toward the cursor
+ *                       (writes the `translate` property) and springs back
+ *                       on leave.
+ *
+ * Mirrors the project's scroll-hook conventions: rAF-coalesced writes, no
+ * React state, passive listeners. No-ops under reduced motion and on coarse
+ * pointers — mobile gets the scroll-band equivalents instead.
+ */
+export const usePointerFX = (
+  rootRef: RefObject<HTMLElement | null>,
+  { maxTiltDeg = 5, magnetStrength = 0.22, magnetMax = 10 }: PointerFXOptions = {},
+): void => {
+  const prefersReducedMotion = usePrefersReducedMotion();
+
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || prefersReducedMotion) { return; }
+    if (typeof window.matchMedia !== 'function') { return; }
+    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) { return; }
+
+    let raf = 0;
+    let target: HTMLElement | null = null;
+    let kind: FXKind | null = null;
+    let pointerX = 0;
+    let pointerY = 0;
+
+    const reset = (el: HTMLElement, k: FXKind) => {
+      if (k === 'tilt') {
+        el.style.transform = '';
+        el.style.removeProperty('--glare-x');
+        el.style.removeProperty('--glare-y');
+      } else {
+        el.style.translate = '';
+      }
+    };
+
+    const apply = () => {
+      raf = 0;
+      if (!target || !kind) { return; }
+      const rect = target.getBoundingClientRect();
+      if (rect.width === 0 || rect.height === 0) { return; }
+      const px = (pointerX - rect.left) / rect.width - 0.5;
+      const py = (pointerY - rect.top) / rect.height - 0.5;
+      if (kind === 'tilt') {
+        const ry = (px * maxTiltDeg * 2).toFixed(2);
+        const rx = (-py * maxTiltDeg * 2).toFixed(2);
+        target.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
+        target.style.setProperty('--glare-x', `${((px + 0.5) * 100).toFixed(1)}%`);
+        target.style.setProperty('--glare-y', `${((py + 0.5) * 100).toFixed(1)}%`);
+      } else {
+        const clamp = (v: number) => Math.max(-magnetMax, Math.min(magnetMax, v));
+        const dx = clamp((pointerX - (rect.left + rect.width / 2)) * magnetStrength);
+        const dy = clamp((pointerY - (rect.top + rect.height / 2)) * magnetStrength);
+        target.style.translate = `${dx.toFixed(1)}px ${dy.toFixed(1)}px`;
+      }
+    };
+
+    const onPointerOver = (e: PointerEvent) => {
+      const el = (e.target as Element | null)?.closest?.('[data-tilt], [data-magnetic]') as HTMLElement | null;
+      if (el === target) { return; }
+      if (target && kind) { reset(target, kind); }
+      target = el && root.contains(el) ? el : null;
+      kind = target ? (target.hasAttribute('data-tilt') ? 'tilt' : 'magnetic') : null;
+    };
+
+    const onPointerMove = (e: PointerEvent) => {
+      if (!target) { return; }
+      pointerX = e.clientX;
+      pointerY = e.clientY;
+      if (!raf) { raf = requestAnimationFrame(apply); }
+    };
+
+    const onPointerOut = (e: PointerEvent) => {
+      if (!target || !kind) { return; }
+      const to = e.relatedTarget as Element | null;
+      if (!to || !target.contains(to)) {
+        reset(target, kind);
+        target = null;
+        kind = null;
+      }
+    };
+
+    root.addEventListener('pointerover', onPointerOver, { passive: true });
+    root.addEventListener('pointermove', onPointerMove, { passive: true });
+    root.addEventListener('pointerout', onPointerOut, { passive: true });
+
+    return () => {
+      root.removeEventListener('pointerover', onPointerOver);
+      root.removeEventListener('pointermove', onPointerMove);
+      root.removeEventListener('pointerout', onPointerOut);
+      if (raf) { cancelAnimationFrame(raf); }
+      if (target && kind) { reset(target, kind); }
+    };
+  }, [rootRef, prefersReducedMotion, maxTiltDeg, magnetStrength, magnetMax]);
+};
