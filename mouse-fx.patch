+import { renderHook } from '@testing-library/react';
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { act } from 'react';
+
+import { usePointerFX } from '../../../hooks/usePointerFX';
+
+const { mockReducedMotion } = vi.hoisted(() => ({ mockReducedMotion: { value: false } }));
+vi.mock('../../../hooks/usePrefersReducedMotion', () => ({
+  usePrefersReducedMotion: () => mockReducedMotion.value,
+}));
+
+/** Build a root with a tilt card and a magnetic button, sized for math. */
+function buildDom() {
+  const root = document.createElement('div');
+  const tilt = document.createElement('div');
+  tilt.setAttribute('data-tilt', '');
+  const magnet = document.createElement('button');
+  magnet.setAttribute('data-magnetic', '');
+  root.appendChild(tilt);
+  root.appendChild(magnet);
+  document.body.appendChild(root);
+  const rect = { left: 0, top: 0, width: 200, height: 100, right: 200, bottom: 100, x: 0, y: 0, toJSON: () => ({}) } as DOMRect;
+  tilt.getBoundingClientRect = () => rect;
+  magnet.getBoundingClientRect = () => rect;
+  return { root, tilt, magnet };
+}
+
+function setFinePointer(matches: boolean) {
+  Object.defineProperty(window, 'matchMedia', {
+    writable: true,
+    value: vi.fn().mockReturnValue({
+      matches,
+      addEventListener: vi.fn(),
+      removeEventListener: vi.fn(),
+    }),
+  });
+}
+
+function firePointer(el: Element, type: string, init: MouseEventInit = {}) {
+  // jsdom lacks PointerEvent — MouseEvent with a pointer event type works for listeners.
+  el.dispatchEvent(new MouseEvent(type, { bubbles: true, ...init }));
+}
+
+describe('usePointerFX', () => {
+  beforeEach(() => {
+    setFinePointer(true);
+    mockReducedMotion.value = false;
+    vi.stubGlobal('requestAnimationFrame', (cb: FrameRequestCallback) => { cb(0); return 0; });
+    vi.stubGlobal('cancelAnimationFrame', vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    document.body.innerHTML = '';
+  });
+
+  it('tilts a [data-tilt] card toward the pointer and resets on leave', () => {
+    const { root, tilt } = buildDom();
+    const rootRef = { current: root };
+    renderHook(() => usePointerFX(rootRef));
+
+    act(() => {
+      firePointer(tilt, 'pointerover');
+      // Bottom-right quadrant: expect positive rotateY, negative rotateX.
+      firePointer(tilt, 'pointermove', { clientX: 200, clientY: 100 });
+    });
+    expect(tilt.style.transform).toMatch(/perspective\(800px\) rotateX\(-?[\d.]+deg\) rotateY\([\d.]+deg\)/);
+    expect(tilt.style.getPropertyValue('--glare-x')).toBe('100.0%');
+    expect(tilt.style.getPropertyValue('--glare-y')).toBe('100.0%');
+
+    act(() => {
+      firePointer(tilt, 'pointerout');
+    });
+    expect(tilt.style.transform).toBe('');
+    expect(tilt.style.getPropertyValue('--glare-x')).toBe('');
+  });
+
+  it('pulls a [data-magnetic] element toward the pointer with a clamp', () => {
+    const { root, magnet } = buildDom();
+    const rootRef = { current: root };
+    renderHook(() => usePointerFX(rootRef));
+
+    act(() => {
+      firePointer(magnet, 'pointerover');
+      // Far right of centre (100, 50): raw dx = 100 * 0.22 = 22 → clamped to 10.
+      firePointer(magnet, 'pointermove', { clientX: 200, clientY: 50 });
+    });
+    expect(magnet.style.translate).toBe('10.0px 0.0px');
+
+    act(() => {
+      firePointer(magnet, 'pointerout');
+    });
+    expect(magnet.style.translate).toBe('');
+  });
+
+  it('no-ops on coarse pointers', () => {
+    setFinePointer(false);
+    const { root, tilt } = buildDom();
+    const rootRef = { current: root };
+    renderHook(() => usePointerFX(rootRef));
+
+    act(() => {
+      firePointer(tilt, 'pointerover');
+      firePointer(tilt, 'pointermove', { clientX: 200, clientY: 100 });
+    });
+    expect(tilt.style.transform).toBe('');
+  });
+
+  it('no-ops under prefers-reduced-motion', () => {
+    mockReducedMotion.value = true;
+    const { root, tilt } = buildDom();
+    const rootRef = { current: root };
+    renderHook(() => usePointerFX(rootRef));
+
+    act(() => {
+      firePointer(tilt, 'pointerover');
+      firePointer(tilt, 'pointermove', { clientX: 200, clientY: 100 });
+    });
+    expect(tilt.style.transform).toBe('');
+  });
+
+  it('removes listeners and resets the active element on unmount', () => {
+    const { root, tilt } = buildDom();
+    const removeSpy = vi.spyOn(root, 'removeEventListener');
+    const rootRef = { current: root };
+    const { unmount } = renderHook(() => usePointerFX(rootRef));
+
+    act(() => {
+      firePointer(tilt, 'pointerover');
+      firePointer(tilt, 'pointermove', { clientX: 200, clientY: 100 });
+    });
+    expect(tilt.style.transform).not.toBe('');
+
+    unmount();
+    expect(tilt.style.transform).toBe('');
+    expect(removeSpy).toHaveBeenCalledWith('pointerover', expect.any(Function));
+    expect(removeSpy).toHaveBeenCalledWith('pointermove', expect.any(Function));
+    expect(removeSpy).toHaveBeenCalledWith('pointerout', expect.any(Function));
+  });
+});
