+import { render } from '@testing-library/react';
+import React from 'react';
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { act } from 'react';
+
+import { LensCursor } from '../../../components/LensCursor';
+
+const { mockReducedMotion } = vi.hoisted(() => ({ mockReducedMotion: { value: false } }));
+vi.mock('../../../hooks/usePrefersReducedMotion', () => ({
+  usePrefersReducedMotion: () => mockReducedMotion.value,
+}));
+
+function setFinePointer(matches: boolean) {
+  Object.defineProperty(window, 'matchMedia', {
+    writable: true,
+    value: vi.fn().mockReturnValue({
+      matches,
+      addEventListener: vi.fn(),
+      removeEventListener: vi.fn(),
+    }),
+  });
+}
+
+function makeZone() {
+  const zone = document.createElement('div');
+  document.body.appendChild(zone);
+  return { current: zone };
+}
+
+describe('LensCursor', () => {
+  beforeEach(() => {
+    mockReducedMotion.value = false;
+    setFinePointer(true);
+    vi.stubGlobal('requestAnimationFrame', (cb: FrameRequestCallback) => { cb(0); return 0; });
+    vi.stubGlobal('cancelAnimationFrame', vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    document.body.innerHTML = '';
+  });
+
+  it('renders the cursor and marks the zone lens-active on fine pointers', () => {
+    const zoneRef = makeZone();
+    const { getByTestId, unmount } = render(<LensCursor zoneRef={zoneRef} />);
+
+    const cursor = getByTestId('lens-cursor');
+    expect(cursor).toHaveAttribute('aria-hidden', 'true');
+    expect(cursor.dataset.variant).toBe('default');
+    expect(cursor.dataset.hidden).toBe('true');
+    expect(zoneRef.current.classList.contains('lens-active')).toBe(true);
+
+    unmount();
+    expect(zoneRef.current.classList.contains('lens-active')).toBe(false);
+  });
+
+  it('renders nothing on coarse pointers', () => {
+    setFinePointer(false);
+    const zoneRef = makeZone();
+    const { container } = render(<LensCursor zoneRef={zoneRef} />);
+    expect(container.firstChild).toBeNull();
+    expect(zoneRef.current.classList.contains('lens-active')).toBe(false);
+  });
+
+  it('renders nothing under prefers-reduced-motion', () => {
+    mockReducedMotion.value = true;
+    const zoneRef = makeZone();
+    const { container } = render(<LensCursor zoneRef={zoneRef} />);
+    expect(container.firstChild).toBeNull();
+  });
+
+  it('switches to the link variant over interactive elements and view over data-cursor cards', () => {
+    const zoneRef = makeZone();
+    const button = document.createElement('button');
+    const card = document.createElement('div');
+    card.setAttribute('data-cursor', 'view');
+    zoneRef.current.appendChild(button);
+    zoneRef.current.appendChild(card);
+
+    const { getByTestId } = render(<LensCursor zoneRef={zoneRef} />);
+    const cursor = getByTestId('lens-cursor');
+
+    act(() => {
+      button.dispatchEvent(new MouseEvent('pointerover', { bubbles: true }));
+    });
+    expect(cursor.dataset.variant).toBe('link');
+
+    act(() => {
+      card.dispatchEvent(new MouseEvent('pointerover', { bubbles: true }));
+    });
+    expect(cursor.dataset.variant).toBe('view');
+  });
+
+  it('hides itself over native-cursor fields and on zone leave', () => {
+    const zoneRef = makeZone();
+    const input = document.createElement('input');
+    zoneRef.current.appendChild(input);
+
+    const { getByTestId } = render(<LensCursor zoneRef={zoneRef} />);
+    const cursor = getByTestId('lens-cursor');
+
+    act(() => {
+      // jsdom MouseEvent has no pointerType — patch it on for the mouse check.
+      const move = new MouseEvent('pointermove', { bubbles: true, clientX: 10, clientY: 10 });
+      Object.defineProperty(move, 'pointerType', { value: 'mouse' });
+      zoneRef.current.dispatchEvent(move);
+    });
+    expect(cursor.dataset.hidden).toBe('false');
+
+    act(() => {
+      input.dispatchEvent(new MouseEvent('pointerover', { bubbles: true }));
+    });
+    expect(cursor.dataset.hidden).toBe('true');
+
+    act(() => {
+      const move = new MouseEvent('pointermove', { bubbles: true, clientX: 12, clientY: 12 });
+      Object.defineProperty(move, 'pointerType', { value: 'mouse' });
+      zoneRef.current.dispatchEvent(move);
+    });
+    expect(cursor.dataset.hidden).toBe('false');
+
+    act(() => {
+      zoneRef.current.dispatchEvent(new MouseEvent('pointerleave'));
+    });
+    expect(cursor.dataset.hidden).toBe('true');
+  });
+
+  it('tracks pressed state', () => {
+    const zoneRef = makeZone();
+    const { getByTestId } = render(<LensCursor zoneRef={zoneRef} />);
+    const cursor = getByTestId('lens-cursor');
+
+    act(() => {
+      zoneRef.current.dispatchEvent(new MouseEvent('pointerdown', { bubbles: true }));
+    });
+    expect(cursor.dataset.pressed).toBe('true');
+
+    act(() => {
+      zoneRef.current.dispatchEvent(new MouseEvent('pointerup', { bubbles: true }));
+    });
+    expect(cursor.dataset.pressed).toBe('false');
+  });
+});
