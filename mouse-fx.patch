+import React, { useEffect, useRef, useState, type RefObject } from 'react';
+
+import { usePrefersReducedMotion } from '../hooks/usePrefersReducedMotion';
+
+interface LensCursorProps {
+  /** The element the lens cursor lives over (the landing canvas). The native
+   *  cursor is hidden inside it via the `.lens-active` class while mounted. */
+  zoneRef: RefObject<HTMLElement | null>;
+}
+
+const FINE_POINTER_QUERY = '(hover: hover) and (pointer: fine)';
+/** Elements the ring opens up over. */
+const INTERACTIVE_SELECTOR = 'a, button, [role="button"], label, summary, [data-cursor]';
+/** Elements that keep their native cursor (the lens hides itself). */
+const NATIVE_CURSOR_SELECTOR = 'input, textarea, select';
+/** Ring lerp factor per frame — lower trails longer. */
+const RING_LERP = 0.16;
+
+/**
+ * Cinematic custom cursor for the landing: a brand dot pinned to the pointer
+ * and a ring that trails it on a lerp. The ring opens over interactive
+ * elements and becomes a corner-ticked viewfinder with a VIEW label over
+ * `data-cursor="view"` cards. Renders nothing on coarse pointers or under
+ * reduced motion, so touch devices and motion-sensitive users keep the
+ * native experience. All per-frame work is direct DOM writes — React renders
+ * exactly once.
+ */
+export const LensCursor: React.FC<LensCursorProps> = ({ zoneRef }) => {
+  const prefersReducedMotion = usePrefersReducedMotion();
+  const [finePointer, setFinePointer] = useState(false);
+
+  const rootRef = useRef<HTMLDivElement>(null);
+  const dotRef = useRef<HTMLDivElement>(null);
+  const ringRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (typeof window.matchMedia !== 'function') { return; }
+    const mq = window.matchMedia(FINE_POINTER_QUERY);
+    setFinePointer(mq.matches);
+    const onChange = (e: MediaQueryListEvent) => setFinePointer(e.matches);
+    mq.addEventListener?.('change', onChange);
+    return () => mq.removeEventListener?.('change', onChange);
+  }, []);
+
+  const active = finePointer && !prefersReducedMotion;
+
+  useEffect(() => {
+    if (!active) { return; }
+    const zone = zoneRef.current;
+    const rootEl = rootRef.current;
+    const dot = dotRef.current;
+    const ring = ringRef.current;
+    if (!zone || !rootEl || !dot || !ring) { return; }
+
+    zone.classList.add('lens-active');
+
+    let raf = 0;
+    let targetX = 0;
+    let targetY = 0;
+    let ringX = 0;
+    let ringY = 0;
+    let started = false;
+
+    const tick = () => {
+      ringX += (targetX - ringX) * RING_LERP;
+      ringY += (targetY - ringY) * RING_LERP;
+      dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, -50%)`;
+      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
+      // Keep lerping until the ring settles, then sleep until the next move.
+      if (Math.abs(targetX - ringX) > 0.1 || Math.abs(targetY - ringY) > 0.1) {
+        raf = requestAnimationFrame(tick);
+      } else {
+        raf = 0;
+      }
+    };
+
+    const wake = () => { if (!raf) { raf = requestAnimationFrame(tick); } };
+
+    const onPointerMove = (e: PointerEvent) => {
+      if (e.pointerType !== 'mouse') { return; }
+      targetX = e.clientX;
+      targetY = e.clientY;
+      if (!started) {
+        // First sight: snap the ring to the pointer instead of flying in from 0,0.
+        started = true;
+        ringX = targetX;
+        ringY = targetY;
+      }
+      rootEl.dataset.hidden = 'false';
+      wake();
+    };
+
+    const onPointerOver = (e: PointerEvent) => {
